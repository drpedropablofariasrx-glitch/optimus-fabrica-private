# OPTIMUS local configuration. Do not place real API keys in this file.
OPTIMUS_HOST=127.0.0.1
OPTIMUS_PORT=5000
OPTIMUS_DEBUG=false
OPTIMUS_DATA_DIR=data
OPTIMUS_LOG_DIR=logs
OPTIMUS_PROVIDER=mock

# External llama-server is optional and is never started by OPTIMUS.
OPTIMUS_LLAMA_BASE_URL=http://127.0.0.1:8080
OPTIMUS_LLAMA_MODEL=
OPTIMUS_LLAMA_TIMEOUT_SECONDS=120
OPTIMUS_LLAMA_API_KEY=
OPTIMUS_LLAMA_HEALTH_PATH=/health
OPTIMUS_LLAMA_MAX_TOKENS=
