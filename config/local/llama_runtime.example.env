OPTIMUS_PROVIDER=llama_cpp
OPTIMUS_LLAMA_BASE_URL=http://127.0.0.1:8080
OPTIMUS_LLAMA_MODEL=Qwen3-8B-Q4_K_M
OPTIMUS_LLAMA_SERVER_EXE=<ruta_absoluta_a_llama-server.exe>
OPTIMUS_LLAMA_MODEL_PATH=<ruta_absoluta_al_GGUF>
OPTIMUS_LLAMA_HOST=127.0.0.1
OPTIMUS_LLAMA_PORT=8080
OPTIMUS_LLAMA_CTX_SIZE=4096
OPTIMUS_LLAMA_GPU_LAYERS=99
OPTIMUS_LLAMA_THREADS=8
