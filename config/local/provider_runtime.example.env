# Copie este archivo como provider_runtime.env y complete solo las claves que use.
# provider_runtime.env está ignorado por Git: nunca copie claves a este ejemplo.

# Proveedor predeterminado al abrir OPTIMUS: openai | deepseek | llama_cpp | mock
OPTIMUS_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
